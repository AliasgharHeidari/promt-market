# Server
APP_NAME=PromptMarketplace
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=secret
DB_NAME=promt_market
DB_SSL_MODE=disable
DB_MAX_CONNECTIONS=25
DB_IDLE_CONNECTIONS=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Encryption
ENCRYPTION_KEY=32-byte-encryption-key-change-this

# Payment
PAYMENT_MERCHANT_ID=xxxx-xxxx-xxxx
PAYMENT_CALLBACK_URL=http://localhost:8080/api/v1/payment/callback

# Rate Limit
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL=1m

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure-admin-password-change-this
